<!-- V2 publication extract, 2026-10-16: five lab rules from local_rules.xml.
     Vendor sample 100001 excluded; do not load alongside the V1 rules or snapshot.
     This extracted file has NOT been redeployed as a separate file on the manager. -->
<group name="windows,sysmon,process_discovery,soc_discovery,">
  <rule id="100100" level="7">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\tasklist\.exe$</field>
    <description>Process discovery using tasklist.exe on $(win.system.computer)</description>
    <mitre>
      <id>T1057</id>
    </mitre>
  </rule>
</group>


<group name="windows,sysmon,system_information_discovery,soc_discovery,">
  <rule id="100101" level="7">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\systeminfo\.exe$</field>
    <description>System information discovery using systeminfo.exe on $(win.system.computer)</description>
    <mitre>
      <id>T1082</id>
    </mitre>
  </rule>
</group>

<group name="windows,sysmon,network_configuration_discovery,soc_discovery,">
  <rule id="100102" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\ipconfig\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:^|\s)/all(?:\s|$)</field>
    <description>Network configuration discovery using ipconfig /all on $(win.system.computer)</description>
    <mitre>
      <id>T1016</id>
    </mitre>
  </rule>
</group>

<group name="windows,sysmon,user_discovery,soc_discovery,">
  <rule id="100103" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\whoami\.exe$</field>
    <description>User discovery using whoami.exe on $(win.system.computer)</description>
    <mitre>
      <id>T1033</id>
    </mitre>
  </rule>
</group>

<group name="windows,sysmon,soc_correlation,">
  <rule id="100110" level="8" frequency="7" timeframe="60">
    <if_matched_group>soc_discovery</if_matched_group>
    <same_field>win.system.computer</same_field>
    <description>Repeated discovery activity within 60 seconds on $(win.system.computer) - review required</description>
  </rule>
</group>
